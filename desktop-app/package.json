{
  "name": "desktop-app",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:protected-py": "python scripts/build_cython_bundle.py",
    "dist:win": "npm run build:protected-py && electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^40.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cn.showbin.mailboat",
    "productName": "Mailboat",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".protected_py",
        "to": ".",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../samples/import_example.xlsx",
        "to": "samples/import_example.xlsx"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mailboat",
      "guid": "9A4F0F44-0D77-4A19-9E7B-5A7B9DB3B8E2"
    }
  }
}
